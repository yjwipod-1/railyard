{
  "contract_version": "0.9.0",
  "canonical_serialization": {
    "standard": "RFC 8785 JSON Canonicalization Scheme",
    "profile": "I-JSON values with integers only; floating-point values are outside this contract",
    "vectors": [
      {
        "name": "empty-object",
        "value": {},
        "canonical_utf8": "{}",
