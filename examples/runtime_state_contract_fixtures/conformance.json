        "canonical_utf8": "{\"array\":[null,true,false,0,-7,42],\"delimiter_string\":\"a:b,c{}[]\",\"nested\":{\"a\":[1,{\"k\":\"v\"}],\"z\":null}}",
        "sha256": "sha256:0b8cd4fc84058be18af361dd70b65e9d44e971cd26dede99188690d11323a816"
      },
      {
        "name": "escaping-and-key-order",
        "value": {
          "z": "line\nquote\"slash\\",
          "a": {"b": 2, "a": 1}
        },
        "canonical_utf8": "{\"a\":{\"a\":1,\"b\":2},\"z\":\"line\\nquote\\\"slash\\\\\"}",
