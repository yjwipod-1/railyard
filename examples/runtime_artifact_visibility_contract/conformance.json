{
  "contract_id": "runtime-artifact-visibility-contract",
  "contract_version": "1.0.0",
  "schema_version": "1.0.0",
  "description": "Generic conformance cases for the RuntimeArtifact visibility amendment contract. All identifiers use the example- prefix. No machine-local paths, secrets, credentials, Control IDs, private domains, or internal development notes.",
  "cases": [
    {
      "case_id": "public-single",
      "description": "A single public artifact produced from a public source artifact. Visibility is resolved to public.",
      "data": {
        "artifact_ref": {
          "artifact_id": "example-artifact-public-001",
          "artifact_kind": "stage_output",
          "artifact_version": "1.0.0"
        },
        "origin_run": "example-run-public-001",
        "origin_stage": "example-build-stage",
        "produced_by": "example-runner-1",
        "source_artifacts": [
          {
            "artifact_id": "example-source-public-001",
            "artifact_kind": "source",
            "artifact_version": "1.0.0"
          }
        ],
        "visibility": "public",
        "visibility_resolution": {
          "resolution_id": "example-resolution-public-001",
          "resolved_at": "2026-07-01T00:00:00Z",
          "contributors": [
            {
              "contributor_id": "example-contrib-source-public-001",
              "contributor_kind": "source_artifact",
              "contributor_ref": {
                "artifact_id": "example-source-public-001",
                "artifact_kind": "source",
                "artifact_version": "1.0.0"
              },
              "asserted_visibility": "public",
              "authority": "Source artifact declares public visibility.",
              "classification_evidence": [
                {
                  "artifact_id": "example-source-public-001",
                  "artifact_kind": "source",
                  "artifact_version": "1.0.0"
                }
              ]
            }
          ],
          "resolution_rule": "most_restrictive",
          "resolved_visibility": "public",
          "resolution_audit": {
            "contributor_count": 1,
            "restricted_count": 0,
            "project_count": 0,
            "public_count": 1,
            "applied_rule": "most_restrictive"
          }
        }
      },
      "expectation": {
        "outcome": "pass",
        "resolved_visibility": "public"
      }
    },
