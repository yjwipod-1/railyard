{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://railyard/schemas/runtime-artifact-visibility-v1.schema.json",
  "title": "Runtime Artifact Visibility Contract",
  "description": "JSON Schema for the RuntimeArtifact visibility amendment defined by references/runtime-artifact-visibility-contract.md v1.0.0. Validates the structural shape of RuntimeArtifact, VisibilityContributor, VisibilityResolution, visibility_context, and all conformance cases. This schema validates structural and pattern constraints only; it does not verify cryptographic signatures, digests, or cross-artifact consistency.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/RuntimeArtifact" },
    { "$ref": "#/$defs/VisibilityContributor" },
    { "$ref": "#/$defs/VisibilityResolution" },
    { "$ref": "#/$defs/VisibilityContext" },
    { "$ref": "#/$defs/ConformanceCase" }
  ],
  "$defs": {
    "ArtifactRef": {
      "type": "object",
      "required": ["artifact_id", "artifact_kind"],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_kind": {
          "type": "string",
          "minLength": 1
        },
        "artifact_version": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "RuntimeArtifact": {
      "type": "object",
      "required": [
        "artifact_ref",
        "origin_run",
        "produced_by",
        "source_artifacts",
        "visibility",
        "visibility_resolution"
      ],
      "properties": {
        "artifact_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "origin_run": {
          "type": "string",
          "minLength": 1
        },
        "origin_stage": {
          "type": "string",
          "minLength": 1
        },
        "produced_by": {
          "type": "string",
          "minLength": 1
        },
        "source_artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          }
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "project", "restricted"]
        },
        "visibility_resolution": {
          "$ref": "#/$defs/VisibilityResolution"
        }
      },
      "additionalProperties": false
    },
    "VisibilityContributor": {
      "type": "object",
      "required": [
        "contributor_id",
        "contributor_kind",
        "contributor_ref",
        "asserted_visibility",
        "authority",
        "classification_evidence"
      ],
      "properties": {
        "contributor_id": {
          "type": "string",
          "minLength": 1
        },
        "contributor_kind": {
          "type": "string",
          "enum": ["source_artifact", "governing_contract", "project_policy", "trigger_provenance"]
        },
        "contributor_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "asserted_visibility": {
          "type": "string",
          "enum": ["public", "project", "restricted"]
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "classification_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          }
        }
      },
      "additionalProperties": false
    },
    "VisibilityResolutionAudit": {
      "type": "object",
      "required": [
        "contributor_count",
        "restricted_count",
        "project_count",
        "public_count",
        "applied_rule"
      ],
      "properties": {
        "contributor_count": {
          "type": "integer",
          "minimum": 1
        },
        "restricted_count": {
          "type": "integer",
          "minimum": 0
        },
        "project_count": {
          "type": "integer",
          "minimum": 0
        },
        "public_count": {
          "type": "integer",
          "minimum": 0
        },
        "applied_rule": {
          "type": "string",
          "const": "most_restrictive"
        }
      },
      "additionalProperties": false
    },
    "VisibilityResolution": {
      "type": "object",
      "required": [
        "resolution_id",
        "resolved_at",
        "contributors",
        "resolution_rule",
        "resolved_visibility",
        "resolution_audit"
      ],
      "properties": {
        "resolution_id": {
          "type": "string",
          "minLength": 1
        },
        "resolved_at": {
          "type": "string",
          "format": "date-time"
        },
        "contributors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/VisibilityContributor"
          }
        },
        "resolution_rule": {
          "type": "string",
          "const": "most_restrictive"
        },
        "resolved_visibility": {
          "type": "string",
          "enum": ["public", "project", "restricted"]
        },
        "resolution_audit": {
          "$ref": "#/$defs/VisibilityResolutionAudit"
        }
      },
      "additionalProperties": false
    },
    "VisibilityContext": {
      "type": "object",
      "required": [
        "trigger_visibility",
        "policy_contributors",
        "contract_contributors",
        "run_visibility_resolution",
        "resolved_run_visibility"
      ],
      "properties": {
        "trigger_visibility": {
          "$ref": "#/$defs/VisibilityContributor"
        },
        "policy_contributors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/VisibilityContributor"
          }
        },
        "contract_contributors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/VisibilityContributor"
          }
        },
        "run_visibility_resolution": {
          "$ref": "#/$defs/VisibilityResolution"
        },
        "resolved_run_visibility": {
          "type": "string",
          "enum": ["public", "project", "restricted"]
        }
      },
      "additionalProperties": false
    },
    "ConformanceCase": {
      "type": "object",
      "required": ["case_id", "description", "data", "expectation"],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object"
        },
        "expectation": {
          "type": "object",
          "required": ["outcome"],
          "properties": {
            "outcome": {
              "type": "string",
              "enum": ["pass", "fail", "rejected"]
            },
            "resolved_visibility": {
              "type": "string",
              "enum": ["public", "project", "restricted"]
            },
            "failure_code": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
