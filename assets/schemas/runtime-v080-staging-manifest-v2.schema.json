{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:railyard:schema:runtime-v080-staging-manifest:v2.0.0",
  "title": "Runtime v0.8 Staging Manifest Schema v2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "release_target", "manifest_id", "external_audit_digest_or_null", "ready_to_stage", "entries", "totals"],
  "properties": {
    "manifest_version": {"const": "2.0.0"},
    "release_target": {"const": "v0.8.0"},
    "manifest_id": {"$ref": "#/$defs/PublicHandle"},
    "external_audit_digest_or_null": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/Digest"}]},
    "ready_to_stage": {"type": "boolean"},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/Entry"}},
    "totals": {"$ref": "#/$defs/Totals"}
  },
  "$defs": {
    "Digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "PublicHandle": {"type": "string", "pattern": "^(?:[a-z][a-z0-9._-]{0,127}|urn:railyard:staging:[a-z][a-z0-9._-]{0,95})$", "not": {"pattern": "(?:system-|domain-|ticket-|epic-|control|mailbox|evidence|workflow|https?|file:|[A-Za-z]:|/)"}},
    "SafePath": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?![A-Za-z]:)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\s*?\\[\\]{}])(?!.*(?:/)$)(?!.*(?:^|/)(?:docs/(?:system|domain)/(?:inbox|outbox)|control|mailbox|evidence|reports|\\.workflow|workflow(?:\\.db)?|\\.git|\\.agents|\\.codex|\\.claude|\\.qwen|\\.obsidian|\\.workbuddy|\\.tmp(?:_doc_review)?|\\.cache|\\.pytest_cache|__pycache__|node_modules|cache|tmp|temp|secrets|credentials|tokens|keys|local|generated|dist)(?:/|$))[A-Za-z0-9._/-]+$", "not": {"pattern": "(?i)(?:^|/)(?:docs/(?:system|domain)/(?:inbox|outbox)|control|mailbox|evidence|reports|\\.workflow|workflow(?:\\.db)?|\\.git|\\.agents|\\.codex|\\.claude|\\.qwen|\\.obsidian|\\.workbuddy|\\.tmp(?:_doc_review)?|\\.cache|\\.pytest_cache|__pycache__|node_modules|cache|tmp|temp|secrets|credentials|tokens|keys|local|generated|dist)(?:/|$)"}},
    "Category": {"enum": ["contract", "schema", "registry", "guide", "policy", "protocol", "reference", "example", "script", "test", "documentation"]},
    "PurposeCode": {"enum": ["runtime_implementation", "governance_authority", "structural_schema", "conformance_fixture", "assurance_test", "public_documentation", "project_configuration", "license", "release_metadata"]},
    "IncludeEntry": {"type": "object", "additionalProperties": false, "required": ["path", "decision", "sha256", "size_bytes", "line_count_or_null", "category", "purpose_code", "provenance_digests", "source_or_derived"], "properties": {"path": {"$ref": "#/$defs/SafePath"}, "decision": {"const": "include"}, "sha256": {"$ref": "#/$defs/Digest"}, "size_bytes": {"type": "integer", "minimum": 0}, "line_count_or_null": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]}, "category": {"$ref": "#/$defs/Category"}, "purpose_code": {"$ref": "#/$defs/PurposeCode"}, "provenance_digests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Digest"}, "uniqueItems": true}, "source_or_derived": {"enum": ["source", "derived"]}, "derivation": {"$ref": "#/$defs/Derivation"}}, "allOf": [{"if": {"properties": {"source_or_derived": {"const": "derived"}}, "required": ["source_or_derived"]}, "then": {"required": ["derivation"]}}, {"if": {"properties": {"source_or_derived": {"const": "source"}}, "required": ["source_or_derived"]}, "then": {"not": {"required": ["derivation"]}}}]},
    "ExcludeEntry": {"type": "object", "additionalProperties": false, "required": ["path", "decision", "reason_code"], "properties": {"path": {"$ref": "#/$defs/SafePath"}, "decision": {"const": "exclude"}, "reason_code": {"enum": ["out_of_scope", "test_fixture", "local_configuration", "secret", "machine_specific", "temporary", "cache", "control_state", "generated_unproven", "policy_excluded"]}}},
    "DeferEntry": {"type": "object", "additionalProperties": false, "required": ["path", "decision", "reason_code"], "properties": {"path": {"$ref": "#/$defs/SafePath"}, "decision": {"const": "defer"}, "reason_code": {"enum": ["pending_provenance", "pending_decision", "pending_derivation", "pending_review"]}}},
    "RemediateEntry": {"type": "object", "additionalProperties": false, "required": ["path", "decision", "reason_code", "remediation_action"], "properties": {"path": {"$ref": "#/$defs/SafePath"}, "decision": {"const": "remediate"}, "reason_code": {"enum": ["needs_provenance", "needs_derivation", "needs_cleanup", "needs_reclassification", "needs_signoff"]}, "remediation_action": {"$ref": "#/$defs/RemediationAction"}}},
    "Entry": {"oneOf": [{"$ref": "#/$defs/IncludeEntry"}, {"$ref": "#/$defs/ExcludeEntry"}, {"$ref": "#/$defs/DeferEntry"}, {"$ref": "#/$defs/RemediateEntry"}]},
    "Derivation": {"type": "object", "additionalProperties": false, "required": ["generator_path", "generator_sha256", "input_path_bindings", "output_verification_rule", "rebuild_policy"], "properties": {"generator_path": {"$ref": "#/$defs/SafePath"}, "generator_sha256": {"$ref": "#/$defs/Digest"}, "input_path_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/InputPathBinding"}}, "output_verification_rule": {"enum": ["immutable_sha256_match", "byte_equality", "content_equality"]}, "rebuild_policy": {"enum": ["rebuild_when_inputs_change", "rebuild_per_manifest", "rebuild_prohibited"]}}},
    "InputPathBinding": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/SafePath"}, "sha256": {"$ref": "#/$defs/Digest"}}},
    "RemediationAction": {"type": "object", "additionalProperties": false, "required": ["action_kind", "owner_class", "completion_rule"], "properties": {"action_kind": {"enum": ["obtain_provenance_digest", "record_derivation", "remove_forbidden_content", "reclassify_content", "request_external_audit"]}, "owner_class": {"enum": ["artifact_steward", "governance_steward", "maintenance_steward", "release_steward"]}, "target_path": {"$ref": "#/$defs/SafePath"}, "target_artifact_digest": {"$ref": "#/$defs/Digest"}, "completion_rule": {"enum": ["digest_resolved", "derivation_registered", "content_reclassified", "path_removed", "audit_digest_confirmed"]}}, "oneOf": [{"required": ["target_path"], "not": {"required": ["target_artifact_digest"]}}, {"required": ["target_artifact_digest"], "not": {"required": ["target_path"]}}]},
    "Totals": {"type": "object", "additionalProperties": false, "required": ["entry_count", "decision_counts", "bytes_total", "lines_total", "line_count_unknown", "composition", "generated_counts"], "properties": {"entry_count": {"type": "integer", "minimum": 0}, "decision_counts": {"$ref": "#/$defs/DecisionCounts"}, "bytes_total": {"type": "integer", "minimum": 0}, "lines_total": {"type": "integer", "minimum": 0}, "line_count_unknown": {"type": "integer", "minimum": 0}, "composition": {"$ref": "#/$defs/Composition"}, "generated_counts": {"$ref": "#/$defs/GeneratedCounts"}}},
    "DecisionCounts": {"type": "object", "additionalProperties": false, "required": ["include", "exclude", "defer", "remediate"], "properties": {"include": {"type": "integer", "minimum": 0}, "exclude": {"type": "integer", "minimum": 0}, "defer": {"type": "integer", "minimum": 0}, "remediate": {"type": "integer", "minimum": 0}}},
    "Composition": {"type": "object", "additionalProperties": false, "required": ["implementation", "assurance"], "properties": {"implementation": {"type": "integer", "minimum": 0}, "assurance": {"type": "integer", "minimum": 0}}},
    "GeneratedCounts": {"type": "object", "additionalProperties": false, "required": ["source", "derived"], "properties": {"source": {"type": "integer", "minimum": 0}, "derived": {"type": "integer", "minimum": 0}}}
  }
}
